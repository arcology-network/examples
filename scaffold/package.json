{
  "name": "scaffold",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:serial": "for f in test/*.ts; do npx hardhat run $f --network TestnetInfo 2>&1 | grep -v 'Nothing to compile'; echo $f 'test completed' || exit 1; done",
    "benchmark:boolArray": "HARDHAT_NETWORK=TestnetInfo  npx hardhat run benchmark/boolArray/gen-tx-parallel-bool-array.test.ts",
    "benchmark:like": "HARDHAT_NETWORK=TestnetInfo  npx hardhat run benchmark/like/gen-tx-parallel-like.test.ts",
    "benchmark:parallelSubCurrency": "HARDHAT_NETWORK=TestnetInfo  npx hardhat run benchmark/parallelSubCurrency/gen-tx-parallel-subCurrency.test.ts",
    "benchmark:subCurrency": "HARDHAT_NETWORK=TestnetInfo  npx hardhat run benchmark/subCurrency/gen-tx-subCurrency.test.ts"
  },
  "devDependencies": {
    "@arcologynetwork/concurrent": "^2.2.4",
    "@arcologynetwork/cli-util": "^1.1.3",
    "@nomicfoundation/hardhat-ethers": "^4.0.3",
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.11",
    "@types/progress": "^2.0.7",
    "chai": "^5.3.3",
    "ethers": "^6.15.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.7",
    "mocha": "^11.7.4",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "progress": "^2.0.3"
  }
}
