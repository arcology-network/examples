    "@uniswap/lib": "^4.0.1-alpha",
    "@uniswap/sdk-core": "^3.1.0",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v3-core": "^1.0.0",
    "@uniswap/v3-periphery": "^1.4.1",
    "@uniswap/v3-sdk": "^3.9.0",
    "base64-sol": "1.0.1"
  }
