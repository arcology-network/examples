{
  "name": "hardhat-project",
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.6",
    "@nomiclabs/hardhat-waffle": "^2.0.3",
    "base64-sol": "1.0.1",
    "chai": "^4.3.6",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.6.9",
    "hardhat": "^2.9.9"
  },
  "scripts": {
    "test:serial": "for f in test/*.js; do npx hardhat run $f --network TestnetInfo 2>&1 | grep -v 'Nothing to compile' ; echo $f 'test completed' || exit 1; done",
    "benchmark:token": "npx hardhat run benchmark/token/gen-tx-token.test.js --network TestnetInfo",
    "benchmark:uniswap": "npx hardhat run benchmark/uniswap/gen-tx-uniswap.test.js --network TestnetInfo",
    "benchmark:sendTx":"arcology.net-tx-sender"
  },
  "dependencies": {
    "@arcologynetwork/concurrent": "^2.2.4",
    "@arcologynetwork/cli-util": "^1.1.2",
    "@ethereumjs/common": "^4.4.0",
